# file: .env.example
#
# Copy to .env and fill in real values (never commit .env — see .gitignore).
# The vars below mirror the shared-contracts table in
# docs/specs/2026-07-02-backend-split-and-docsvc-ingestion-plan.md §4.5.
#
# NOTE: keep comments on their own lines. This file is consumed by several
# dotenv parsers (docker compose env_file, docker run --env-file, shell
# sourcing) and not all of them strip inline comments — a trailing
# "# comment" can silently become part of the value (this actually happened:
# GRADIO_USER_ID leaked its inline comment as the X-User-Id header).

# === LLM (FastAPI backend, src/sme_chatbot/api) — required ===
# bearer token for LLM_BASE_URL
LLM_API_TOKEN=changeme
# OpenAI-compatible chat endpoint (required, no default)
LLM_BASE_URL=https://your-llm-endpoint/api/v1
# model name served at LLM_BASE_URL. Default gpt-6-luna (was gpt-6-sol).
LLM_MODEL=gpt-6-luna
# Optional sampling. Leave unset to use the server's own defaults (for qwen3.6 on
# Ollama: temperature 1 and no seed, so two runs of the same question differ).
# Set both for reproducible eval runs; 0 is a valid temperature.
# LLM_TEMPERATURE=0.2
# LLM_SEED=42
# Optional cap on the tokens of one LLM call, reasoning included. Unset = no cap.
# Bounds a thinking model that loops; a call cut off by it shows as finish "length"
# in the usage timings and the eval report. Leave generous: too low truncates answers.
# LLM_MAX_TOKENS=4096
# Optional reasoning control, passed through as the OpenAI `reasoning_effort`. Unset = the
# model reasons as usual. Ollama (qwen3.8:27b): "none" turns reasoning off, "low"/"high" do
# nothing. Azure gpt-5: "minimal", "low", "medium" or "high".
# Chosen default: unset on qwen3.8 — same accuracy as "none" and far fewer round-cap
# hits, for ~2 s more p50. On gpt-5 use "minimal": "low" is slower for no clear gain.
# LLM_REASONING_EFFORT=none
# Reasoning control for the single retry made when a call hits LLM_MAX_TOKENS before showing
# any text (reasoning can use the whole budget). Unset = retry with the settings above.
# On Ollama "none" makes the retry answer directly.
# LLM_RETRY_REASONING_EFFORT=none
# Which OpenAI API to call: "chat_completions" (default, /v1/chat/completions; Ollama
# and other OpenAI-compatible servers) or "responses" (/v1/responses, Azure OpenAI). Use
# "responses" when Azure answers "Function tools with reasoning_effort are not supported ...
# in /v1/chat/completions": it keeps tools and reasoning together. LLM_SEED is not sent there.
# LLM_API=responses
# Optional: search on the user's question before the first LLM call (documents domain, only
# when a matricola is in scope), saving one LLM call of time-to-first-token. Default false.
# Recommended on: 1-2 s off p50 and TTFT on the full eval set, no accuracy cost.
# CHAT_PRE_SEARCH=true
# Results the pre-search returns; unset = the search tool's default (8). Fewer = shorter first prompt.
# CHAT_PRE_SEARCH_RESULTS=5
# Tool calls of one LLM round run at the same time, up to this many; default 4. A round then
# takes as long as its slowest call. 1 runs them one after another, as before (rollback switch).
# CHAT_TOOL_CONCURRENCY=1

# === Example: Ollama instead of a hosted LLM ===
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_TOKEN=your-token
# LLM_MODEL=qwen3.6:35b

# === Backend auth (src/sme_chatbot/api/auth.py) ===
# "dev" (optional X-User-Id header, no token) or "jwt" (Entra ID bearer)
AUTH_MODE=dev
# expected JWT audience — required when AUTH_MODE=jwt
JWT_AUDIENCE=changeme
# Entra ID tenant id — required when AUTH_MODE=jwt
JWT_TENANT_ID=changeme

# === ChromaDB collection paths (backend tools: cdo_rag / manuals_rag / docsvc_rag) ===
# CDO domain vector store (collection CHROMA_CDO_COLLECTION, default "cdo_docs")
CHROMA_CDO_DIR=data/chroma_cdo_db
# Documents domain vector store (collection CHROMA_DOCSVC_COLLECTION, default "docsvc")
CHROMA_DOCSVC_DIR=data/chroma_docsvc_db
# Manuals domain vector store (collection CHROMA_MANUALS_COLLECTION, default "manuals")
CHROMA_MANUALS_DIR=data/chroma_manuals_db
# Collection names: set these only to keep using a store whose collection has
# another name, or rename it with scripts/rename_chroma_collection.py
# CHROMA_CDO_COLLECTION=cdo_docs
# CHROMA_DOCSVC_COLLECTION=docsvc
# CHROMA_MANUALS_COLLECTION=manuals

# === Retrieval (documents domain, tools/docsvc_rag.py) ===
# keyword index path; empty = $CHROMA_DOCSVC_DIR/lexical_fts.sqlite3.
# Build it with: sme-ingest-docsvc --build-lexical-index
LEXICAL_INDEX_PATH=
# hybrid (dense + BM25 keyword, default) or dense (embeddings only)
RETRIEVAL_MODE=hybrid
# load the retrieval stores at API startup, in the background, instead of on
# the first request: off (default), on (load model + collections, run one query
# of each kind) or full (on, then read the documents store's files into the OS
# page cache; only useful with the RAM to keep ~9 GB cached)
RETRIEVAL_WARMUP=off

# === Gradio frontend (frontends/gradio_app.py) ===
# base URL of the FastAPI backend
CHATBOT_API_URL=http://localhost:8000
# set true to launch with a public gradio.live share link
CHATBOT_SHARE=false
# optional: sent as X-User-Id on every chat request
GRADIO_USER_ID=

# === DocumentService ingestion (sme-ingest-docsvc / src/sme_chatbot/ingestion) ===
# How to obtain the credentials: docs/procedures/docsvc-ingestion.md.
# DocumentService resource / app-ID-URI
DOCSVC_AUDIENCE=api://changeme
# optional override; defaults to https://login.microsoftonline.com/{DOCSVC_TENANT_ID}
DOCSVC_AUTHORITY=
# DocumentService REST API base URL
DOCSVC_BASE_URL=https://documents-api.example.com
# app registration holding the Documents.Read app role
DOCSVC_READ_CLIENT_ID=changeme
# client secret for DOCSVC_READ_CLIENT_ID
DOCSVC_READ_CLIENT_SECRET=changeme
# optional override; defaults to {DOCSVC_AUDIENCE}/.default
DOCSVC_SCOPE=
# Entra ID tenant id
DOCSVC_TENANT_ID=changeme
# optional GUID sent as X-User-Id for audit
DOCSVC_USER_ID=
# set false only for self-signed local/dev endpoints
DOCSVC_VERIFY_SSL=true

# === Langfuse (LLM observability, optional) ===
# Langfuse instance URL (self-hosted or cloud)
LANGFUSE_BASE_URL=https://your-langfuse-instance
# set true to route LLM calls through Langfuse's OpenAI wrapper
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme

# === Eval (sme-chatbot-eval, -retrieval, -trend; src/sme_chatbot/eval) ===
# Golden sets and run records live in a separate private eval-data repo.
# Clone it at data/eval/ and leave these unset, or point them at
# another checkout.
# EVAL_DATASETS_DIR=data/eval/datasets
# EVAL_RESULTS_DIR=data/eval/results

# === Logging (all components) ===
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === Log shipping to Loki (alloy service in docker-compose.yml) ===
# Opt-in: uncomment on a deployment host (e.g. deploy-host) to start the
# Alloy sidecar with `docker compose up`. Leave unset on a dev box.
# See docs/procedures/docker-deployment.md "Shipping logs to Loki".
# COMPOSE_PROFILES=observability
# exactly dev | staging | prod - any other value falls out of Loki retention and dashboards
# ALLOY_ENV=prod
# the host's name, stamped on every stream as the hostname label
# HOSTNAME_LABEL=deploy-host
# the brand label on every stream (default acme), to split streams by brand
# LOKI_BRAND=acme
# required when the profile is on: the shared Loki's push endpoint
# LOKI_URL=https://loki.example.com/loki/api/v1/push
# this application's own ingest credential (write-only) - never reuse another's
# INGEST_USERNAME=chatbot-agent
# INGEST_PASSWORD=changeme

# === Deployment (backend, src/sme_chatbot/api) ===
# Reported at GET /health and OpenAPI info.version. Set by the release
# workflow's `docker build --build-arg` from the release tag - do not set
# this by hand; leave unset locally, it defaults to "dev".
# APP_VERSION=0.5.2

# ---------------------------------------------------------------------------
# The variables below are used by scripts/tests outside src/sme_chatbot and
# are not part of the plan's §4.5 table, but still belong in a local .env.
# ---------------------------------------------------------------------------

# === HuggingFace (embedding model download: sentence-transformers) ===
# only needed if the embedding model is gated
HF_TOKEN=my-huggingface-token

# EOF
